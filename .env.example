# Django (RELEASE)
DEBUG=False
SECRET_KEY=change-me-to-random-secret-key
ALLOWED_HOSTS=127.0.0.1,0.0.0.0,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# PostgreSQL (в Docker хост сервиса — db)
DB_HOST_PGSQL=db
DB_PORT_PGSQL=5432
DB_NAME_PGSQL=shop_PrakUcheb
DB_USERNAME_PGSQL=postgres
DB_PASSWORD_PGSQL=postgres

# Суперпользователь Django (создаётся entrypoint при первом запуске)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Если в SECRET_KEY или пароле есть символ $ — экранируйте для docker-compose: $$
